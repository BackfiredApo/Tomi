---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PageHero from "../components/PageHero.astro";
import ServiceCard from "../components/ServiceCard.astro";

const services = [
  {
    title: "Apparel Manufacturing",
    text: "T-shirts, polos, hoodies, work trousers, denim, womenswear and kidswear.",
    href: "/apparel-manufacturing",
    image: "/images/ranges/apparel.webp"
  },
  {
    title: "Home Storage Products",
    text: "Sourcing for fabric storage boxes, closet organizers, kitchen and bathroom storage products.",
    href: "/home-storage-products",
    image: "/images/home-storage-products-visual.jpg"
  }
];
---

<BaseLayout
  title="Consumer Product Sourcing from China | Tomi Trading"
  description="OEM and ODM consumer product sourcing support for apparel manufacturing, home storage products, packaging and export coordination."
  image="/images/home-storage-products-visual.jpg"
>
  <PageHero
    title="Consumer products"
    text="Apparel and home storage sourcing, with OEM and ODM support."
    image="/images/home-storage-products-visual.jpg"
    imageAlt="Consumer products placeholder"
  />

  <section class="section white">
    <div class="container">
      <div class="section-header">
        <h2>Product categories</h2>
      </div>
      <div class="grid two">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="content-block">
        <h2>Production support</h2>
        <ul>
          <li>Factory quotes and samples</li>
          <li>Packaging, labels and carton details</li>
          <li>Pre-shipment checks as required</li>
        </ul>
      </div>
      <div class="image-frame">
        <img src="/images/garments-visual.jpg" alt="Garments" loading="lazy" />
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
