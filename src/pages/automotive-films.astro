---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryProfile from "../components/CategoryProfile.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="PPF & TPU Color Change Film Sourcing from China | Tomi Trading"
  description="China sourcing support for PPF and TPU color change film, including product option, packaging and export coordination for automotive film distributors and installers."
  image="/images/automotive-film-placeholder.jpg"
>
  <PageHero
    eyebrow="Automotive films"
    title="PPF and TPU color change film sourcing from China"
    text="We help automotive film distributors and installers review PPF and TPU color change film requirements with suitable factory partners, including product options, packaging and export coordination."
    image="/images/automotive-film-placeholder.jpg"
    imageAlt="Automotive paint protection film roll"
  />

  <CategoryProfile
    clients={["Automotive film distributors", "Detailing studios and installer networks", "Private-label automotive accessory buyers"]}
    customization={["Film type, finish and color range", "Roll size and inner-core requirements", "Private label, carton and accessory packaging"]}
    moq="MOQ depends on film type, finish, color range, roll size and factory partner requirements."
    packaging="Roll protection, cartons, labels and shipping marks can be coordinated based on the selected product range."
    markets="Suitable for export-focused distributors and installers; destination-market requirements should be reviewed in the RFQ."
    rfqHint="Tell us whether you need PPF or color change film, desired finish or color, roll size, quantity and target market."
  />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Product discussion</p>
        <h2>Details worth clarifying before quotation</h2>
        <p class="lead">Film selection is project-specific. We help structure the discussion with factory partners rather than making performance claims before the correct product is confirmed.</p>
      </div>
      <div class="grid four">
        <article class="card feature-card">
          <span class="mark">01</span>
          <h3>Film range</h3>
          <p>Clarify PPF, TPU color change film, finish preference and the color or SKU range you need to review.</p>
        </article>
        <article class="card feature-card">
          <span class="mark">02</span>
          <h3>Roll format</h3>
          <p>Share roll width, length, core preference and sample needs so the option comparison starts from usable details.</p>
        </article>
        <article class="card feature-card">
          <span class="mark">03</span>
          <h3>Brand presentation</h3>
          <p>Private-label cartons, labels, inserts and sales-kit requirements can be discussed with the selected partner.</p>
        </article>
        <article class="card feature-card">
          <span class="mark">04</span>
          <h3>Shipment planning</h3>
          <p>Carton information, loading considerations and forwarder coordination can be prepared when the order is ready.</p>
        </article>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
