---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PageHero from "../components/PageHero.astro";
import ServiceCard from "../components/ServiceCard.astro";

const services = [
  {
    title: "CNC Machining",
    text: "Aluminum, steel and stainless-steel parts, CNC turning, fixtures and second-source quotation support.",
    href: "/cnc-machining",
    image: "/images/cnc-machined-parts-visual.jpg"
  },
  {
    title: "Sheet Metal Fabrication",
    text: "Laser cutting, bending, welding, riveting, panels, covers, brackets, cabinets and small assemblies.",
    href: "/sheet-metal-fabrication",
    image: "/images/sheet-metal-fabrication-visual.jpg"
  },
  {
    title: "Small Machinery & Power Equipment",
    text: "OEM sourcing and factory matching for generators, pumps and light industrial machines.",
    href: "/small-machinery-power-equipment",
    image: "/images/small-machinery-visual.jpg"
  }
];
---

<BaseLayout
  title="Industrial Manufacturing Sourcing from China | Tomi Trading"
  description="China sourcing support for CNC machining, sheet metal fabrication, small machinery, power equipment and custom industrial components."
  image="/images/sheet-metal-fabrication-visual.jpg"
>
  <PageHero
    title="Industrial manufacturing"
    text="Parts and equipment sourcing for manufacturers and industrial buyers."
    image="/images/sheet-metal-fabrication-visual.jpg"
    imageAlt="Industrial manufacturing placeholder"
  />

  <section class="section white">
    <div class="container">
      <div class="section-header">
        <h2>Capabilities</h2>
      </div>
      <div class="grid three">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="content-block">
        <h2>Common projects</h2>
        <ul>
          <li>Prototype and small-batch quotes</li>
          <li>Second-source suppliers for spare parts</li>
          <li>Specification review, sampling and production follow-up</li>
          <li>Inspection based on buyer requirements</li>
        </ul>
      </div>
      <div class="image-frame">
        <img src="/images/cnc-machined-parts-visual.jpg" alt="CNC machined parts" loading="lazy" />
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
