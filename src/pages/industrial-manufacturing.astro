---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PageHero from "../components/PageHero.astro";
import ServiceCard from "../components/ServiceCard.astro";

const services = [
  {
    title: "CNC Machining",
    text: "Aluminum, steel and stainless-steel parts, CNC turning, fixtures and second-source quotation support.",
    href: "/cnc-machining",
    image: "/images/cnc-machining-placeholder.jpg"
  },
  {
    title: "Sheet Metal Fabrication",
    text: "Laser cutting, bending, welding, riveting, panels, covers, brackets, cabinets and small assemblies.",
    href: "/sheet-metal-fabrication",
    image: "/images/sheet-metal-placeholder.jpg"
  },
  {
    title: "Small Machinery & Power Equipment",
    text: "OEM sourcing and factory matching for generators, pumps and light industrial machines.",
    href: "/small-machinery-power-equipment",
    image: "/images/small-machinery-placeholder.jpg"
  }
];
---

<BaseLayout
  title="Industrial Manufacturing Sourcing from China | Tomi Trading"
  description="China sourcing support for CNC machining, sheet metal fabrication, small machinery, power equipment and custom industrial components."
  image="/images/sheet-metal-placeholder.jpg"
>
  <PageHero
    eyebrow="Industrial manufacturing"
    title="Industrial parts, components and equipment sourcing from China"
    text="We support overseas equipment manufacturers, automation companies, machinery companies, agricultural equipment companies, automotive component companies and industrial buyers."
    image="/images/sheet-metal-placeholder.jpg"
    imageAlt="Industrial manufacturing placeholder"
  />

  <section class="section white">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Capabilities</p>
        <h2>Manufacturing partner coordination for practical industrial RFQs</h2>
        <p class="lead">
          Share drawings, sample photos, performance requirements or target products. We
          will check feasibility and coordinate quotation feedback with suitable factory
          partners.
        </p>
      </div>
      <div class="grid three">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="content-block">
        <p class="eyebrow">Common project types</p>
        <h2>From prototype parts to production sourcing</h2>
        <p>
          We can support industrial buyers looking for custom brackets, fixtures, panels,
          machine components, spare parts, covers, cabinets and selected power equipment.
        </p>
        <ul>
          <li>Prototype and small-batch quotation support</li>
          <li>Second-source supplier search for replacement or spare parts</li>
          <li>Specification review, sample coordination and production follow-up</li>
          <li>Inspection scope arranged based on buyer requirements and product type</li>
        </ul>
      </div>
      <div class="image-frame">
        <img src="/images/cnc-machining-placeholder.jpg" alt="CNC machining placeholder" loading="lazy" />
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
