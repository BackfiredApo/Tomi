---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import CategoryProfile from "../components/CategoryProfile.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="Small Machinery & Power Equipment Sourcing from China | Tomi Trading"
  description="Factory matching and export coordination for generators, water pumps, small power equipment and light industrial machines from China."
  image="/images/small-machinery-visual.jpg"
>
  <PageHero
    title="Small machinery & power equipment"
    text="Generators, water pumps, compactors and light industrial equipment."
    image="/images/small-machinery-visual.jpg"
    imageAlt="Small machinery placeholder"
  />

  <CategoryProfile
    clients={["Importers and regional distributors", "Agricultural and construction equipment buyers", "Wholesale and project procurement teams"]}
    customization={["Model, power and voltage options", "Color, label and packaging requirements", "Accessories and spare-part configuration"]}
    moq="Varies by model, configuration and packing."
    packaging="Cartons, pallets, accessory packing and shipping marks."
    markets="Options depend on the destination, including Brazil and Saudi Arabia."
    rfqHint="Share the model, power or voltage, quantity, packing and destination."
  />

  <section class="section">
    <div class="container split">
      <div class="content-block">
        <h2>Factory and export support</h2>
        <p>Compare models and OEM options with the production team.</p>
      </div>
      <div class="grid two">
        <article class="card feature-card">
          <h3>Specification review</h3>
          <p>Confirm model and electrical specifications before quoting.</p>
        </article>
        <article class="card feature-card">
          <h3>Export coordination</h3>
          <p>Packing details, documents and forwarder handover.</p>
        </article>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
