---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { SITE } from "../data/site";
import { PRODUCT_RANGES } from "../data/capabilities";

const mailtoAction = `mailto:${SITE.email}?subject=RFQ%20from%20Tomi%20Trading%20website`;
---

<BaseLayout
  title="Contact Tomi Trading | China Sourcing RFQ"
  description="Contact Guangzhou Tomi Trading Co., Ltd. for sourcing and custom manufacturing RFQs by email or WhatsApp."
  image="/images/contact-rfq-visual.jpg"
>
  <PageHero
    title="Contact & inquiries"
    text="Send your product specifications or a reference photo."
    image="/images/contact-rfq-visual.jpg"
    imageAlt="RFQ workspace with Guangzhou skyline"
  >
    <Fragment slot="actions">
      <a class="button primary" href="#rfq">Inquiry form</a>
      <a class="button secondary" href="#contact-options">Contact options</a>
    </Fragment>
  </PageHero>

  <section class="section white">
    <div class="container split contact-layout">
      <div class="card contact-details" id="contact-options">
        <div class="contact-line">
          <strong>Company</strong>
          <span>{SITE.companyName}</span>
        </div>
        <div class="contact-line">
          <strong>Location</strong>
          <span>{SITE.location}</span>
        </div>
        <div class="contact-line">
          <strong>Email</strong>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
        <div class="contact-line">
          <strong>WhatsApp</strong>
          <a href={SITE.whatsappUrl}>{SITE.whatsappDisplay}</a>
        </div>
        <div class="button-row">
          <a class="button secondary" href={mailtoAction}>Email a drawing</a>
        </div>
      </div>

      <form class="card feature-card" id="rfq" action={mailtoAction} method="post" enctype="text/plain">
        <h2>Request a quote</h2>
        <div class="form-grid">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="Name" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="company">Company</label>
            <input id="company" name="Company" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="country">Country</label>
            <input id="country" name="Country" autocomplete="country-name" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="Email" type="email" autocomplete="email" required />
          </div>
          <div class="field full">
            <label for="category">Product category</label>
            <select id="category" name="Product category">
              <option value="">Select a category</option>
              {PRODUCT_RANGES.map((range) => <option value={range.title} data-category={range.id}>{range.title}</option>)}
              <option value="Sheet metal fabrication">Sheet metal fabrication</option>
              <option value="Small machinery and power equipment">Small machinery and power equipment</option>
              <option value="Home storage products">Home storage products</option>
              <option value="Other sourcing request">Other sourcing request</option>
            </select>
          </div>
          <div class="field full">
            <label for="message">Project details</label>
            <textarea id="message" name="Message / RFQ details" placeholder="Specifications, quantity and destination market"></textarea>
          </div>
        </div>
        <p class="note">Attach drawings or photos to the email draft before sending.</p>
        <div class="button-row">
          <button class="button primary" type="submit">Open email draft</button>
          <a class="button secondary" href={SITE.whatsappUrl}>WhatsApp Us</a>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const select = document.querySelector<HTMLSelectElement>("#category");
  const requestedCategory = new URLSearchParams(window.location.search).get("category");
  const option = Array.from(select?.options ?? []).find((item) => item.dataset.category === requestedCategory);
  if (select && option) select.value = option.value;
</script>
