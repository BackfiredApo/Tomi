---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PageHero from "../components/PageHero.astro";
import { SERVICE_LINKS } from "../data/site";
---

<BaseLayout
  title="China Sourcing Services | Tomi Trading"
  description="Factory sourcing, OEM and ODM coordination, sample support, quality inspection and consolidated shipping support from Guangzhou, China."
  image="/images/sourcing-services-visual.jpg"
>
  <PageHero
    title="Sourcing services from China"
    text="Factory sourcing, sampling, inspection and shipping support for overseas buyers."
    image="/images/sourcing-services-visual.jpg"
    imageAlt="Sourcing and export coordination workspace"
  />

  <section class="section white">
    <div class="container">
      <div class="section-header">
        <h2>What we handle</h2>
      </div>
      <div class="service-grid full-width-services">
        {SERVICE_LINKS.map((service) => (
          <article class="service-tile">
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="content-block">
        <h2>What to send for a quote</h2>
        <p>We use your specifications to confirm the factory, sample and inspection options.</p>
      </div>
      <div class="service-side-note">
        <ul class="compact-list">
          <li>Drawing, sample photo or product link</li>
          <li>Target quantity and schedule</li>
          <li>Material, color and finish</li>
          <li>Packaging and destination market</li>
        </ul>
        <a class="button primary" href="/contact/#rfq">Send an RFQ</a>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
