---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import CategoryProfile from "../components/CategoryProfile.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="Home Storage Product Sourcing from China | Tomi Trading"
  description="China sourcing support for fabric storage boxes, closet organizers, kitchen and bathroom storage products, OEM packaging and wholesale orders."
  image="/images/home-storage-products-visual.jpg"
>
  <PageHero
    title="Home storage products"
    text="Household organizers and storage products for wholesalers and importers."
    image="/images/home-storage-products-visual.jpg"
    imageAlt="Home storage products placeholder"
  />

  <CategoryProfile
    clients={["Wholesalers and importers", "Home organization brands", "Retail and e-commerce buying teams"]}
    customization={["Material, dimensions and color", "Label, insert card and retail packaging", "Carton marking and assortment configuration"]}
    moq="Varies by material, size, color and packaging."
    packaging="OEM packaging, labels, polybags and carton dimensions."
    markets="Share any destination-market packaging requirements."
    rfqHint="Send a photo, dimensions, material, colors, quantity and packing details."
  />

  <section class="section">
    <div class="container split">
      <div class="content-block">
        <h2>Product range</h2>
        <ul>
          <li>Fabric storage boxes and foldable organizers</li>
          <li>Closet and wardrobe organizers</li>
          <li>Kitchen and bathroom storage products</li>
        </ul>
      </div>
      <div class="image-frame">
        <img src="/images/home-storage-products-visual.jpg" alt="Home storage products" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Order specifications</h2>
      </div>
      <div class="grid three">
        <article class="card feature-card"><h3>Materials</h3><p>Fabric, board, plastic or metal accessories.</p></article>
        <article class="card feature-card"><h3>Size and color</h3><p>Dimensions, color references and variants.</p></article>
        <article class="card feature-card"><h3>Shipping</h3><p>Destination, sales channel and shipment preference.</p></article>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
