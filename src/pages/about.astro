---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="About Guangzhou Tomi Trading Co., Ltd. | Tomi Trading"
  description="Learn how Tomi Trading supports overseas buyers with China sourcing, custom manufacturing coordination, quality checking and export support."
  image="/images/about-tomi-trading-visual.jpg"
>
  <PageHero
    title="About Tomi Trading"
    text="Based in Guangzhou, we help overseas buyers source and develop products with factories in China."
    image="/images/about-tomi-trading-visual.jpg"
    imageAlt="Industrial and consumer product samples in Guangzhou"
  />

  <section class="section white">
    <div class="container split">
      <div class="content-block">
        <h2>What we supply</h2>
      </div>
      <div class="grid two">
        <article class="card feature-card">
          <h3>Industrial Manufacturing</h3>
          <p>CNC, sheet metal, cables, automotive films and small machinery.</p>
        </article>
        <article class="card feature-card">
          <h3>Consumer Products</h3>
          <p>Apparel, pet toys and home storage.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>How we help</h2>
      </div>
      <div class="grid three">
        <article class="card feature-card">
          <h3>Requirement review</h3>
          <p>We review drawings, samples or briefs before quoting.</p>
        </article>
        <article class="card feature-card">
          <h3>Factory partner matching</h3>
          <p>We match your project with a factory by process, volume and market.</p>
        </article>
        <article class="card feature-card">
          <h3>Export preparation</h3>
          <p>We coordinate documents, packing details and forwarder handover.</p>
        </article>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
