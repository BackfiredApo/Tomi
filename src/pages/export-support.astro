---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="Export Support from China | Tomi Trading"
  description="Export support from China including commercial invoice, packing list, carton information, HS code coordination, freight forwarder coordination and shipping support."
  image="/images/export-support-visual.jpg"
>
  <PageHero
    title="Export support"
    text="Documents, packing details and freight handover for orders from China."
    image="/images/export-support-visual.jpg"
    imageAlt="Unbranded cartons and pallet prepared for export handover"
  />

  <section class="section white">
    <div class="container split">
      <div class="content-block">
        <h2>Documents and shipping</h2>
        <p>Confirm destination customs requirements with your broker or forwarder.</p>
        <ul>
          <li>Commercial invoice and packing list</li>
          <li>Carton dimensions and weights</li>
          <li>HS code coordination</li>
          <li>Air or sea freight handover</li>
        </ul>
      </div>
      <div class="grid two">
        <article class="card feature-card">
          <h3>For buyers</h3>
          <p>Order and packing details for your logistics team.</p>
        </article>
        <article class="card feature-card">
          <h3>For forwarders</h3>
          <p>Product descriptions and shipment-ready paperwork.</p>
        </article>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
