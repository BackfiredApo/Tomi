---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="Quality Inspection & Factory Coordination | Tomi Trading"
  description="Factory screening, drawing review, material confirmation, dimensional inspection, sample confirmation and pre-shipment checking support in China."
  image="/images/quality-inspection-placeholder.jpg"
>
  <PageHero
    eyebrow="Quality & inspection"
    title="Quality coordination based on project requirements"
    text="We support factory screening, drawing review, material confirmation, sample confirmation, dimensional inspection and pre-shipment checking where required."
    image="/images/quality-inspection-placeholder.jpg"
    imageAlt="Quality inspection placeholder"
  />

  <section class="section white">
    <div class="container split">
      <div class="content-block">
        <p class="eyebrow">Careful quality wording</p>
        <h2>Inspection scope depends on the product and buyer requirement</h2>
        <p>
          We do not invent certifications or promise the same inspection process for every
          project. Quality documentation can be arranged based on project requirements.
          Inspection scope depends on the product type, order quantity and buyer
          requirements.
        </p>
        <ul>
          <li>Factory screening and capability communication</li>
          <li>Drawing review and technical clarification</li>
          <li>Material confirmation where required</li>
          <li>Dimensional inspection and sample confirmation</li>
          <li>Pre-shipment checking and photo documentation support</li>
          <li>Inspection reports when required and feasible</li>
        </ul>
      </div>
      <div class="image-frame">
        <img src="/images/quality-inspection-placeholder.jpg" alt="Quality inspection placeholder" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Project fit</p>
        <h2>Different products need different checks</h2>
      </div>
      <div class="grid three">
        <article class="card feature-card">
          <h3>Custom metal parts</h3>
          <p>Dimensional checks, drawing review and inspection reports can be arranged depending on tolerance and order requirements.</p>
        </article>
        <article class="card feature-card">
          <h3>Small machinery</h3>
          <p>Model, specification, packing and basic pre-shipment checking can be coordinated based on buyer needs.</p>
        </article>
        <article class="card feature-card">
          <h3>Consumer products</h3>
          <p>Samples, color, packaging, quantity and appearance checks can be coordinated before shipment.</p>
        </article>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
