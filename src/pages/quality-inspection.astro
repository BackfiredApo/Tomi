---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="Quality Inspection & Factory Coordination | Tomi Trading"
  description="Factory screening, drawing review, material confirmation, dimensional inspection, sample confirmation and pre-shipment checking support in China."
  image="/images/quality-inspection-visual.jpg"
>
  <PageHero
    title="Quality inspection"
    text="We coordinate sample checks, dimensional inspection and pre-shipment checks."
    image="/images/quality-inspection-visual.jpg"
    imageAlt="Precision measurement tools and machined component"
  />

  <section class="section white">
    <div class="container split">
      <div class="content-block">
        <h2>Inspection scope</h2>
        <p>We confirm the checks and available reports for each order.</p>
        <ul>
          <li>Factory screening and drawing review</li>
          <li>Material, dimensions and sample checks</li>
          <li>Pre-shipment checks and photo documentation</li>
        </ul>
      </div>
      <div class="image-frame">
        <img src="/images/quality-site-visit-visual.jpg" alt="On-site dimensional inspection of a machined component" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Checks by product</h2>
      </div>
      <div class="grid three">
        <article class="card feature-card">
          <h3>Custom metal parts</h3>
          <p>Drawing review, tolerances and dimensional reports where applicable.</p>
        </article>
        <article class="card feature-card">
          <h3>Small machinery</h3>
          <p>Model, specifications and packing.</p>
        </article>
        <article class="card feature-card">
          <h3>Consumer products</h3>
          <p>Samples, color, quantity, appearance and packaging.</p>
        </article>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
