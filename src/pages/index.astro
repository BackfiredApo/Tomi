---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { PRODUCT_CATEGORIES, SERVICE_LINKS, SITE } from "../data/site";

const steps = [
  { number: "01", title: "Share the requirement" },
  { number: "02", title: "Review product options" },
  { number: "03", title: "Confirm the next step" }
];
---

<BaseLayout
  title="Tomi Trading | China Supply Partner for Industrial & Consumer Products"
  description="Tomi Trading is a Guangzhou sourcing partner for CNC machined parts, small machinery, home storage, automotive films and garments."
  image="/images/guangzhou-skyline-hero.jpg"
>
  <section class="hero hero-city">
    <div class="hero-city-overlay"></div>
    <div class="container hero-city-content">
      <p class="eyebrow">Guangzhou, China</p>
      <p class="hero-wordmark">Tomi Trading</p>
      <h1>Your China Supply Partner.</h1>
      <p class="lead">
        Industrial parts, small machinery, home storage, automotive films and garments
        sourced and coordinated from Guangzhou.
      </p>
      <div class="button-row">
        <a class="button primary" href="/contact">Start an Inquiry</a>
        <a class="button secondary light" href={SITE.whatsappUrl}>WhatsApp Us</a>
      </div>
      <p class="hero-trust-line">Source in China. Customize for your market. Ship with clarity.</p>
    </div>
  </section>

  <section class="section statement-section">
    <div class="container statement-grid">
      <p class="eyebrow">Our mission</p>
      <div>
        <h2>Make China sourcing clearer and easier to manage.</h2>
        <p>
          We turn a product brief into a practical buying conversation, from product matching
          and samples to packaging and shipment coordination.
        </p>
      </div>
    </div>
  </section>

  <section class="section white" id="product-categories">
    <div class="container">
      <div class="section-header products-header">
        <p class="eyebrow">What we source</p>
        <h2>Selected product categories</h2>
        <p class="lead">Start with the category closest to your requirement. We will help clarify the useful next details.</p>
      </div>
      <div class="category-grid">
        {PRODUCT_CATEGORIES.map((category) => <ServiceCard {...category} />)}
      </div>
    </div>
  </section>

  <section class="section" id="sourcing-services">
    <div class="container service-layout compact-service-layout">
      <div class="service-layout-copy">
        <p class="eyebrow">How we help</p>
        <h2>Simple support around the order.</h2>
        <p>One China-side contact for the work that sits between a product requirement and an export-ready order.</p>
        <a class="button text" href="/services">Explore our services</a>
      </div>
      <div class="service-grid">
        {SERVICE_LINKS.map((service) => (
          <article class="service-tile">
            <span>{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section white compact-process-section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">A straightforward start</p>
        <h2>From brief to next step.</h2>
      </div>
      <div class="mini-process-grid">
        {steps.map((step) => (
          <article>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Ready when you are"
    title="Start with one product brief."
    text="A drawing, photo, product link or buying list is enough to begin the conversation."
    primaryLabel="Send an RFQ"
    secondaryLabel="WhatsApp Us"
    secondaryHref={SITE.whatsappUrl}
  />
</BaseLayout>
