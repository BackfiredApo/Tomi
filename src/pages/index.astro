---
import BaseLayout from "../layouts/BaseLayout.astro";
import RangeGrid from "../components/RangeGrid.astro";
import { inquiryHref } from "../data/capabilities";

const steps = [
  { title: "Share your brief", text: "Send a drawing, tech pack or product reference." },
  { title: "Review options", text: "We check feasibility and coordinate samples." },
  { title: "Confirm the order", text: "Agree on price, timing, quality checks and shipping." },
];
---

<BaseLayout
  title="Tomi Trading | Manufacturing & Product Supply from China"
  description="CNC machining, apparel and work trousers, pet toys, network and USB cables, and automotive films. Product development, samples and export coordination from Guangzhou."
  image="/images/guangzhou-skyline-hero.jpg"
>
  <section class="hero hero-city" aria-labelledby="home-title">
    <div class="hero-city-overlay" aria-hidden="true"></div>
    <div class="container hero-city-content">
      <p class="eyebrow">Guangzhou, China</p>
      <h1 id="home-title">Manufacturing &amp; supply from China.</h1>
      <p class="lead">CNC parts, apparel, pet toys, cables and automotive films.</p>
      <div class="button-row">
        <a class="site-action light-action" href={inquiryHref()}>Start an inquiry <span aria-hidden="true">↗</span></a>
        <a class="site-action outline-action" href="#product-categories">Explore products <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="wide-container range-section home-ranges" id="product-categories" aria-labelledby="range-heading">
    <div class="range-section-head">
      <h2 id="range-heading">Product ranges</h2>
      <a class="inline-action" href="/products/">View all capabilities <span aria-hidden="true">↗</span></a>
    </div>
    <RangeGrid />
  </section>

  <section class="wide-container range-section production-section" id="sourcing-services" aria-labelledby="production-heading">
    <div class="production-intro">
      <h2 id="production-heading">How we work</h2>
      <a href="/services/" class="inline-action">View sourcing services <span aria-hidden="true">↗</span></a>
    </div>
    <ol class="production-steps">
      {steps.map((step) => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}
    </ol>
  </section>

  <div class="wide-container inquiry-wrap">
    <section class="inquiry-band" aria-labelledby="home-inquiry-heading">
      <h2 id="home-inquiry-heading">Get a quote for your project</h2>
      <a class="site-action light-action" href={inquiryHref()}>Send an RFQ <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</BaseLayout>
