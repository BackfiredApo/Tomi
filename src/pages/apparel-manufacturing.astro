---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import CategoryProfile from "../components/CategoryProfile.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="Apparel Manufacturing & OEM Clothing Sourcing from China | Tomi Trading"
  description="OEM and ODM apparel manufacturing sourcing for T-shirts, blanks, streetwear basics, fabric sourcing, samples and bulk orders."
  image="/images/garments-visual.jpg"
>
  <PageHero
    eyebrow="Apparel manufacturing"
    title="Garment sourcing for T-shirts, hoodies, pants and jeans"
    text="We support T-shirts, hoodies, pants, jeans, blanks and everyday apparel with fabric, size, color, sample and bulk order coordination."
    image="/images/garments-visual.jpg"
    imageAlt="Apparel manufacturing placeholder"
  />

  <CategoryProfile
    clients={["Clothing brands and private-label buyers", "Wholesalers and retail buying teams", "Streetwear and basic apparel programs"]}
    customization={["Fabric, weight and wash", "Size range, colorway and fit", "Label, print, embroidery and packaging"]}
    moq="MOQ depends on fabric, style complexity, colorway count and selected manufacturing partner."
    packaging="Hangtags, labels, polybags, folding method, carton assortment and shipping marks can be discussed before production."
    markets="Suitable for overseas brands, wholesalers and importers; buyer specifications should include destination-market needs."
    rfqHint="A tech pack is ideal. A reference photo with fabric, size range, target quantity and packaging idea is also a helpful start."
  />

  <section class="section">
    <div class="container split">
      <div class="content-block">
        <p class="eyebrow">Clothing sourcing</p>
        <h2>Useful support for importers, brands and wholesalers</h2>
        <p>
          Apparel sourcing often depends on clear fabric choices, fit details, color
          matching, sample confirmation and consistent packaging. We help organize these
          details with suitable manufacturing partners.
        </p>
        <ul>
          <li>T-shirts, hoodies, pants, jeans, blanks and custom apparel</li>
          <li>OEM/ODM production and style development coordination</li>
          <li>Fabric sourcing and material option communication</li>
          <li>Size, color, label and packaging coordination</li>
          <li>Sample and bulk order support</li>
        </ul>
      </div>
      <div class="grid two">
        <article class="card feature-card">
          <h3>Samples</h3>
          <p>Sample support helps confirm fabric, fit, workmanship and packaging before bulk production.</p>
        </article>
        <article class="card feature-card">
          <h3>Bulk orders</h3>
          <p>Bulk order follow-up can include production communication, checking and shipment preparation.</p>
        </article>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
