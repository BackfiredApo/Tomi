---
interface Props {
  clients: string[];
  customization: string[];
  moq: string;
  packaging: string;
  markets: string;
  rfqHint: string;
}

const { clients, customization, moq, packaging, markets, rfqHint } = Astro.props;
---

<section class="section white category-profile">
  <div class="container product-summary">
    <div class="content-block">
      <h2>Order options</h2>
      <div class="profile-columns">
        <div>
          <h3>Suitable for</h3>
          <ul class="compact-list">
            {clients.map((client) => <li>{client}</li>)}
          </ul>
        </div>
        <div>
          <h3>Common customization</h3>
          <ul class="compact-list">
            {customization.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <dl class="sourcing-facts">
        <div>
          <dt>MOQ</dt>
          <dd>{moq}</dd>
        </div>
        <div>
          <dt>Packaging</dt>
          <dd>{packaging}</dd>
        </div>
        <div>
          <dt>Export markets</dt>
          <dd>{markets}</dd>
        </div>
      </dl>
      <p class="rfq-hint"><strong>For a quote:</strong> {rfqHint}</p>
      <div class="button-row">
        <a class="button primary" href="/contact">Request a Quote</a>
        <a class="button secondary" href="https://wa.me/8615817011257">Discuss on WhatsApp</a>
      </div>
    </div>
  </div>
</section>
