---
import { SITE } from "../data/site";
import { inquiryHref } from "../data/capabilities";

interface Props {
  category?: string;
}

const { category } = Astro.props;
---

<aside class="quick-contact" aria-label="Quick inquiry options">
  <a href={SITE.whatsappUrl}>WhatsApp</a>
  <a href={inquiryHref(category)}>Send RFQ</a>
</aside>
