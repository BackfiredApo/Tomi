---
import { SITE } from "../data/site";
---

<section class="section contact-cta">
  <div class="container">
    <div class="card contact-card">
      <div>
        <p class="eyebrow">RFQ support</p>
        <h2>Start with one product brief.</h2>
        <p>Drawing / product photo / sample requirement / sourcing brief.</p>
      </div>
      <div class="contact-actions">
        <a class="button primary" href={`mailto:${SITE.email}?subject=RFQ%20Request%20for%20Tomi%20Trading`}>
          Email Us
        </a>
        <a class="button secondary" href={SITE.whatsappUrl}>WhatsApp Us</a>
      </div>
    </div>
  </div>
</section>
