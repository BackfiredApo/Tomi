---
interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  image?: string;
  imageAlt?: string;
}

const { eyebrow, title, text, image, imageAlt = title } = Astro.props;
---

<section class="page-hero">
  <div class="container page-hero-grid">
    <div class="page-hero-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lead">{text}</p>
      <div class="button-row">
        <slot name="actions">
          <a class="button primary" href="/contact/#rfq">Request a Quote</a>
        </slot>
      </div>
    </div>
    {
      image && (
        <div class="page-hero-image">
          <img src={image} alt={imageAlt} fetchpriority="high" decoding="async" />
        </div>
      )
    }
  </div>
</section>
