---
interface Props {
  title: string;
  text: string;
  href: string;
  image?: string;
  meta?: string;
}

const { title, text, href, image, meta = "Service" } = Astro.props;
---

<a class="card service-card" href={href}>
  {image && <img src={image} alt={title} loading="lazy" />}
  <div class="service-card-body">
    <span class="meta">{meta}</span>
    <h3>{title}</h3>
    <p>{text}</p>
    <span class="card-link">View capability</span>
  </div>
</a>
